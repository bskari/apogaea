// RH_ASK(uint16_t speed=2000, uint8_t rxPin=11, uint8_t txPin=12, uint8_t pttPin=10, bool pttInverted=false)
RH_ASK driver(2000, RH_INVALID_PIN, 23, RH_INVALID_PIN);

void setup() {
  RemoteXY_Init();
  Serial.begin(115200);
  if (!driver.init()) {
    while (true) {
      Serial.println("Radio init failed");
      delay(1000);
    }
  }
  RemoteXY.brightnessSlider = DEFAULT_BRIGHTNESS;
  RemoteXY.rainbowSwitch = false;
  RemoteXY.normalizeBandsSwitch = true;
  RemoteXY.speedSlider = DEFAULT_SPEED;
  RemoteXY.sensitivitySlider = DEFAULT_SENSITIVITY;
  RemoteXY.patternLength = DEFAULT_PATTERN_LENGTH;
  RemoteXY.tileOffset = DEFAULT_TILE_OFFSET;
}

void sendRadioUpdate();

void loop() {
  RemoteXY_t previous(RemoteXY);
  while (true) {
    RemoteXY_Handler();

    if (RemoteXY.connect_flag) {
      previous.connect_flag = RemoteXY.connect_flag;
      if (previous != RemoteXY) {
        Serial.printf("%ld sending\n", millis());
        sendRadioUpdate();
      }
      previous = RemoteXY;
    }
  }
}

void sendRadioUpdate() {
  RadioConfigMessage_t message;
  message.brightness = RemoteXY.brightnessSlider;
  message.sensitivity = RemoteXY.sensitivitySlider;
  message.speed = RemoteXY.speedSlider;
  message.rainbow = RemoteXY.rainbowSwitch;
  message.normalizeBands = RemoteXY.normalizeBandsSwitch;
  message.rgbButton = RemoteXY.rgbButton;
  uint16_t mask = 0;
  for (int i = 0; i < 15; ++i) {
    mask |= static_cast<uint16_t>((&RemoteXY.rgb01Switch)[i]) << i;
  }
  message.rgb = mask;
  uint8_t buffer[sizeof(message)];
  memcpy(buffer, &message, sizeof(message));
  driver.send(buffer, sizeof(message));
  driver.waitPacketSent();
}
